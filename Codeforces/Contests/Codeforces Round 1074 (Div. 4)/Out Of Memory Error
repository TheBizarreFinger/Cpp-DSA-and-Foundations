#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, m;
        long long h;
        cin >> n >> m >> h;
        long long og[n];
        long long curr[n];
        for (int i = 0; i < n; i++) {
            cin >> og[i];
            curr[i] = og[i];
        }
        for (int i = 0; i < m; i++) {
            int b;
            long long c;
            cin >> b >> c;
            int index = b - 1;
            if (curr[index] + c > h) {
                for (int j = 0; j < n; j++) {
                    curr[j] = og[j];
                }
            } else {
                curr[index] = curr[index] + c;
            }
        }
        for (int i = 0; i < n; i++) {
            cout << curr[i] << " ";
        }
        cout << endl;
    }
    return 0;
}
